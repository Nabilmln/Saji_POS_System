DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/database?sslmode=require
NEON_AUTH_BASE_URL=https://example.invalid/neon-auth
NEON_AUTH_JWKS_URL=https://example.invalid/neon-auth/jwks
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_TOKEN_SECRET=replace-with-a-different-32-byte-random-secret
# Neon private images bucket; server-only, also required on the app host for photo uploads:
AWS_ACCESS_KEY_ID=replace-with-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret
AWS_ENDPOINT_URL_S3=https://your-branch.storage.region.aws.neon.tech
AWS_REGION=ap-southeast-1
# For the one-time trusted admin bootstrap after creating the Neon Auth user:
# BOOTSTRAP_ADMIN_USER_ID=00000000-0000-4000-8000-000000000001
# BOOTSTRAP_ADMIN_NAME=Restaurant Admin
# Set these only after creating the matching Managed Auth users (BE-03).
# SEED_ADMIN_USER_ID=00000000-0000-4000-8000-000000000001
# SEED_CASHIER_USER_ID=00000000-0000-4000-8000-000000000002
